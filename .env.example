# ─── Base de dades ────────────────────────────────────────────────────────────
# Neon PostgreSQL: https://neon.tech → Project → Connection string
#
# Vercel (recomanat les dues; si només tens DATABASE_URL pooler, el deploy deriva DIRECT_URL):
#   DATABASE_URL = «Pooled connection» (host amb -pooler) — per l'app en runtime
#   DIRECT_URL   = «Direct connection» (host sense -pooler) — per prisma migrate deploy
#
# App (pooler, ok per queries):
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"
# Migracions Prisma (sense -pooler; obligatori per evitar P1002 advisory lock):
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generar amb: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Opcional (només local). A Vercel els Excel d'importació es desen a Neon.
# UPLOADS_DIR="C:\\dev\\OpsiaFinance\\uploads"
