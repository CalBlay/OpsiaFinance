# ─── Base de dades ────────────────────────────────────────────────────────────
# Neon PostgreSQL: https://neon.tech → Project → Connection string
# App (pooler, ok per queries):
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Migracions Prisma (sense -pooler; obligatori per evitar P1002 advisory lock):
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/DATABASE?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generar amb: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
