{
  "name": "opsia-finance",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @opsia/frontend",
    "build": "npm run build --workspace @opsia/frontend",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node scripts/prisma-deploy.mjs",
    "postprisma:migrate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.14.1",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/pg": "^8.11.14",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write --no-errors-on-unmatched"],
    "*.{css,json,md}": ["biome format --write --no-errors-on-unmatched"]
  }
}
