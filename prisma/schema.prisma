generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  role            UserRole        @default(CONSULTA)
  isActive        Boolean         @default(true)
  passwordHash    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ajustos         Ajust[]
  carreguesFitxer CarregaFitxer[]
  imports         Importacio[]
}

/// Dimensió 1 — Línia de negoci (LN00000, LN00001, …)
model LiniaNegoci {
  id                   String                  @id @default(cuid())
  codi                 String                  @unique
  nom                  String
  ordre                Int                     @default(0)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  ajustos              Ajust[]
  centres              Centre[]
  dadesResultat        DadaResultat[]
  rows                 ImportRow[]
  importacions         Importacio[]
  movimentsRepartiment MovimentRepartiment[]   @relation("MovimentDesti")
  liniesNegociDesti    NormaRepartiment[]      @relation("NormaDesti")
  liniesNegociOrigen   NormaRepartiment[]      @relation("NormaOrigen")
  pesosRepartiment              PesRepartiment[]
  grupsRepartiment              RepartimentGrupMembre[]
  configPersonalLn              ConfigPersonalLn?
  configPersonalDept            ConfigPersonalDept[]
  pesDefectePersonalComercial   PesDefectePersonalComercial?
}

/// Dimensió 2 — Centre de cost (CCR00001, CCC00003, …)
model Centre {
  id                      String                     @id @default(cuid())
  codi                    String
  nom                     String
  liniaNegociId           String
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  ordre                   Int                        @default(0)
  updatedAt               DateTime                   @updatedAt
  ajustos                 Ajust[]
  liniaNegoci             LiniaNegoci                @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)
  costsPersonalsCentre    CostPersonalCentre[]
  costsSalarials          CostSalarialRestaurant[]
  dadesResultat           DadaResultat[]
  departaments            Departament[]
  rows                    ImportRow[]
  mapeigsCostPersonal     MapeigCodiCostPersonal[]
  mapeigsTextCentre       MapeigTextCentreTreball[]
  movimentsTraspassDesti  MovimentTraspassPersonal[] @relation("TraspassDesti")
  movimentsTraspassOrigen MovimentTraspassPersonal[] @relation("TraspassOrigen")
  vendesArticles          VendaArticleRestaurant[]
  vendesDiaries           VendaDiariaRestaurant[]

  @@unique([liniaNegociId, codi])
  @@index([liniaNegociId])
}

/// Dimensió 3 — Departament / àrea interna del centre (DRO0001, DCC0002, …)
/// Els codis de departament es repeteixen entre centres → únic per centre.
model Departament {
  id                   String                  @id @default(cuid())
  codi                 String
  nom                  String
  ordre                Int                     @default(0)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  centreId             String
  centre               Centre                  @relation(fields: [centreId], references: [id], onDelete: Cascade)
  rows                 ImportRow[]
  mapeigsCostPersonal  MapeigCodiCostPersonal[]
  costsPersonalsCentre CostPersonalCentre[]
  configPersonalDept   ConfigPersonalDept[]

  @@unique([centreId, codi])
  @@index([centreId])
}

/// Periode comptable: any + mes
model Period {
  id                       String                    @id @default(cuid())
  any                      Int
  mes                      Int
  nom                      String
  ajustos                  Ajust[]
  carreguesFitxer          CarregaFitxer[]
  costsPersonalsCentre     CostPersonalCentre[]
  costsSalarials           CostSalarialRestaurant[]
  dadesResultat            DadaResultat[]
  execucioRepartiment      ExecucioRepartiment?
  execucioTraspassPersonal ExecucioTraspassPersonal?
  rows                     ImportRow[]
  imports                  Importacio[]
  vendesArticles           VendaArticleRestaurant[]
  vendesDiaries            VendaDiariaRestaurant[]

  @@unique([any, mes])
}

/// Definició d'un tipus d'informe Excel (configurable)
model FormatInforme {
  id           String       @id @default(cuid())
  nom          String       @unique
  descripcio   String?
  tipusInforme TipusInforme
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  imports      Importacio[]
}

/// Registre d'un fitxer Excel pujat al sistema
model Importacio {
  id                         String                     @id @default(cuid())
  nomFitxer                  String
  rutaStorage                String?
  mida                       Int?
  estat                      EstatImport                @default(PENDENT)
  notes                      String?
  formatInformeId            String?
  periodId                   String?
  creatPer                   String
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  confirmatAt                DateTime?
  liniaNegociId              String?
  dades                      DadaResultat[]
  execucionsTraspassPersonal ExecucioTraspassPersonal[]
  rows                       ImportRow[]                @relation("ImportacioRows")
  creatPerUser               User                       @relation(fields: [creatPer], references: [id])
  formatInforme              FormatInforme?             @relation(fields: [formatInformeId], references: [id])
  liniaNegoci                LiniaNegoci?               @relation(fields: [liniaNegociId], references: [id])
  period                     Period?                    @relation(fields: [periodId], references: [id])

  @@index([liniaNegociId])
  @@index([periodId, liniaNegociId, formatInformeId])
}

/// Fila normalitzada del model financer intern
model ImportRow {
  id            String       @id @default(cuid())
  periodId      String
  liniaNegociId String?
  centreId      String?
  codiCompte    String?
  nomCompte     String
  familiaCompte String?
  import_       Decimal      @map("import") @db.Decimal(18, 2)
  esAjust       Boolean      @default(false)
  notes         String?
  importacioId  String
  departamentId String?
  centre        Centre?      @relation(fields: [centreId], references: [id])
  departament   Departament? @relation(fields: [departamentId], references: [id])
  importacio    Importacio   @relation("ImportacioRows", fields: [importacioId], references: [id], onDelete: Cascade)
  liniaNegoci   LiniaNegoci? @relation(fields: [liniaNegociId], references: [id])
  period        Period       @relation(fields: [periodId], references: [id])

  @@index([importacioId])
  @@index([periodId])
  @@index([liniaNegociId])
  @@index([centreId])
  @@index([departamentId])
}

/// Estructura estable del compte de resultats (una fila per línia del P&L de SAP).
/// El `node` és l'identificador estable que SAP genera igual a tots els informes.
model ConcepteResultat {
  id         String         @id @default(cuid())
  node       Int            @unique
  descripcio String
  esSubtotal Boolean        @default(false)
  ordre      Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  ajustos    Ajust[]
  dades      DadaResultat[]
}

/// Fet financer: valor d'un concepte per un centre (o LN) en un període concret.
/// Cada cel·la amb valor del compte de resultats es desa aquí. Des d'aquests fets
/// es poden agregar totes les vistes (per centre, per LN, per empresa, mensual, anual…).
model DadaResultat {
  id                 String           @id @default(cuid())
  importacioId       String
  periodId           String
  concepteResultatId String
  centreId           String?
  liniaNegociId      String?
  senseCentre        Boolean          @default(false)
  import_            Decimal          @map("import") @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  centre             Centre?          @relation(fields: [centreId], references: [id])
  concepteResultat   ConcepteResultat @relation(fields: [concepteResultatId], references: [id])
  importacio         Importacio       @relation(fields: [importacioId], references: [id], onDelete: Cascade)
  liniaNegoci        LiniaNegoci?     @relation(fields: [liniaNegociId], references: [id])
  period             Period           @relation(fields: [periodId], references: [id])

  @@index([importacioId])
  @@index([periodId])
  @@index([concepteResultatId])
  @@index([centreId])
  @@index([liniaNegociId])
  @@index([periodId, centreId])
  @@index([periodId, liniaNegociId])
  @@index([periodId, concepteResultatId])
}

/// Ajust manual sobre el compte de resultats. NO sobreescriu les dades importades:
/// a les consultes es suma a la dada SAP (dada + ajustos = xifra final).
model Ajust {
  id                 String           @id @default(cuid())
  periodId           String
  concepteResultatId String
  centreId           String?
  liniaNegociId      String?
  import_            Decimal          @map("import") @db.Decimal(18, 2)
  motiu              String
  creatPer           String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  centre             Centre?          @relation(fields: [centreId], references: [id])
  concepteResultat   ConcepteResultat @relation(fields: [concepteResultatId], references: [id])
  creatPerUser       User             @relation(fields: [creatPer], references: [id])
  liniaNegoci        LiniaNegoci?     @relation(fields: [liniaNegociId], references: [id])
  period             Period           @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@index([concepteResultatId])
  @@index([centreId])
  @@index([liniaNegociId])
}

model RepartimentGrup {
  id        String                  @id @default(cuid())
  codi      String                  @unique
  nom       String
  ordre     Int                     @default(0)
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  normes    NormaRepartiment[]
  pesos     PesRepartiment[]
  membres   RepartimentGrupMembre[]
}

model RepartimentGrupMembre {
  id            String          @id @default(cuid())
  grupId        String
  liniaNegociId String
  ordre         Int             @default(0)
  grup          RepartimentGrup @relation(fields: [grupId], references: [id], onDelete: Cascade)
  liniaNegoci   LiniaNegoci     @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)

  @@unique([grupId, liniaNegociId])
  @@index([liniaNegociId])
}

model NormaRepartiment {
  id                  String                @id @default(cuid())
  nom                 String?
  tipus               TipusNormaRepartiment
  ordre               Int                   @default(0)
  actiu               Boolean               @default(true)
  liniaNegociDestiId  String?
  liniaNegociOrigenId String?
  concepteNode        Int
  grupId              String?
  valorPercent        Decimal?              @db.Decimal(9, 4)
  valorImport         Decimal?              @db.Decimal(18, 2)
  vigentDesDe         DateTime              @default(now())
  vigentFins          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  moviments           MovimentRepartiment[]
  grup                RepartimentGrup?      @relation(fields: [grupId], references: [id])
  liniaNegociDesti    LiniaNegoci?          @relation("NormaDesti", fields: [liniaNegociDestiId], references: [id])
  liniaNegociOrigen   LiniaNegoci?          @relation("NormaOrigen", fields: [liniaNegociOrigenId], references: [id])

  @@index([liniaNegociDestiId])
  @@index([liniaNegociOrigenId])
  @@index([grupId])
}

model ExecucioRepartiment {
  id           String                   @id @default(cuid())
  periodId     String                   @unique
  estat        EstatExecucioRepartiment @default(BORRADOR)
  calculatAt   DateTime?
  confirmatAt  DateTime?
  confirmatPer String?
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  period       Period                   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  moviments    MovimentRepartiment[]
  pesos        PesRepartiment[]
}

model PesRepartiment {
  id            String              @id @default(cuid())
  execucioId    String
  grupId        String
  liniaNegociId String
  vendesBase    Decimal             @db.Decimal(18, 2)
  pesCalculat   Decimal             @db.Decimal(9, 6)
  pesOverride   Decimal?            @db.Decimal(9, 6)
  execucio      ExecucioRepartiment @relation(fields: [execucioId], references: [id], onDelete: Cascade)
  grup          RepartimentGrup     @relation(fields: [grupId], references: [id], onDelete: Cascade)
  liniaNegoci   LiniaNegoci         @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)

  @@unique([execucioId, grupId, liniaNegociId])
}

model MovimentRepartiment {
  id                 String              @id @default(cuid())
  execucioId         String
  normaId            String?
  liniaNegociDestiId String
  concepteNode       Int
  importCalculat     Decimal             @db.Decimal(18, 2)
  importOverride     Decimal?            @db.Decimal(18, 2)
  detallCalcul       String?
  execucio           ExecucioRepartiment @relation(fields: [execucioId], references: [id], onDelete: Cascade)
  liniaNegociDesti   LiniaNegoci         @relation("MovimentDesti", fields: [liniaNegociDestiId], references: [id], onDelete: Cascade)
  norma              NormaRepartiment?   @relation(fields: [normaId], references: [id])

  @@index([execucioId])
  @@index([liniaNegociDestiId])
}

/// Mode d'assignació de personal SC per LN configurable (LN00001, 00004, 00005, 00006).
model ConfigPersonalLn {
  id             String                    @id @default(cuid())
  liniaNegociId  String                    @unique
  mode           ModeRepartimentPersonalLn @default(PERCENT_DEPT)
  /// Quan mode = FIX_TOTAL: import mensual repartit entre departaments actius (pes intern).
  importFixTotal Decimal?                  @db.Decimal(18, 2)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  liniaNegoci    LiniaNegoci               @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)
}

/// Assignació per departament SC (LN00000) cap a una LN configurable.
model ConfigPersonalDept {
  id            String      @id @default(cuid())
  liniaNegociId String
  departamentId String
  actiu         Boolean     @default(true)
  /// Mode PERCENT_DEPT: % del cost del departament (nòmina+millores).
  percentDept   Decimal?    @db.Decimal(9, 4)
  /// Mode FIX_TOTAL: pes relatiu dins l'import fix de la LN.
  pesInternFix  Decimal?    @db.Decimal(9, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  liniaNegoci   LiniaNegoci @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)
  departament   Departament @relation(fields: [departamentId], references: [id], onDelete: Cascade)

  @@unique([liniaNegociId, departamentId])
  @@index([departamentId])
}

/// Pes per defecte quan LN00002/LN00003 no tenen vendes al mes (sobrant automàtic).
model PesDefectePersonalComercial {
  id            String      @id @default(cuid())
  liniaNegociId String      @unique
  pesDefecte    Decimal     @db.Decimal(9, 6)
  liniaNegoci   LiniaNegoci @relation(fields: [liniaNegociId], references: [id], onDelete: Cascade)
}

/// Configuració global del mòdul (singleton).
model ConfigTraspassPersonal {
  id         String   @id @default("default")
  tarifaHora Decimal  @default(18) @db.Decimal(18, 2)
  updatedAt  DateTime @updatedAt
}

/// Mapeig text (Organizaciones o Proyecto) → centre de cost + departament.
model MapeigTextCentreTreball {
  id          String              @id @default(cuid())
  text        String              @unique
  centreId    String
  ordre       Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  /// Font de veritat: Sala/Serveis → SALA, Cuina/Cuiner → CUINA.
  departament DepartamentSalarial @default(SALA)
  centre      Centre              @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@index([centreId])
  @@index([departament])
}

/// Execució mensual de traspassos de personal (un per període).
model ExecucioTraspassPersonal {
  id                     String                        @id @default(cuid())
  periodId               String                        @unique
  estat                  EstatExecucioTraspassPersonal @default(BORRADOR)
  importacioId           String?
  nomFitxer              String?
  calculatAt             DateTime?
  confirmatAt            DateTime?
  confirmatPer           String?
  notes                  String?
  alertesJson            String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  /// Snapshot JSON dels canvis a foraCentre (abans/després) en confirmar.
  foraCentreSnapshotJson String?
  importacio             Importacio?                   @relation(fields: [importacioId], references: [id])
  period                 Period                        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  moviments              MovimentTraspassPersonal[]

  @@index([importacioId])
}

/// Moviment agregat origen → destí × departament (Sala/Cuina).
model MovimentTraspassPersonal {
  id             String                   @id @default(cuid())
  execucioId     String
  centreOrigenId String
  centreDestiId  String
  hores          Decimal                  @db.Decimal(18, 2)
  tarifaHora     Decimal                  @db.Decimal(18, 2)
  import_        Decimal                  @map("import") @db.Decimal(18, 2)
  concepteNode   Int                      @default(13)
  /// Departament copiat del mapeig d'origen (font de veritat) en calcular.
  departament    DepartamentSalarial      @default(SALA)
  /// Minuts agregats (font Excel); hores = minuts / 60.
  minuts         Decimal                  @default(0) @db.Decimal(18, 2)
  centreDesti    Centre                   @relation("TraspassDesti", fields: [centreDestiId], references: [id], onDelete: Cascade)
  centreOrigen   Centre                   @relation("TraspassOrigen", fields: [centreOrigenId], references: [id], onDelete: Cascade)
  execucio       ExecucioTraspassPersonal @relation(fields: [execucioId], references: [id], onDelete: Cascade)

  @@index([execucioId])
  @@index([centreOrigenId])
  @@index([centreDestiId])
  @@index([departament])
}

/// Registre d'un fitxer Excel pujat (operatiu restaurants).
model CarregaFitxer {
  id                   String                   @id @default(cuid())
  tipus                TipusCarregaFitxer
  nomFitxer            String
  mida                 Int?
  periodId             String?
  resum                String?
  notes                String?
  creatPer             String
  createdAt            DateTime                 @default(now())
  creatPerUser         User                     @relation(fields: [creatPer], references: [id])
  period               Period?                  @relation(fields: [periodId], references: [id])
  costsPersonalsCentre CostPersonalCentre[]
  costsSalarials       CostSalarialRestaurant[]
  vendesArticles       VendaArticleRestaurant[]
  vendesDiaries        VendaDiariaRestaurant[]

  @@index([tipus, createdAt])
  @@index([periodId])
}

/// Fet de cost salarial per restaurant, departament (Sala/Cuina) i període.
/// Font independent del compte de resultats SAP. Upsert per period+centre+departament.
model CostSalarialRestaurant {
  id                 String              @id @default(cuid())
  periodId           String
  centreId           String
  departament        DepartamentSalarial
  totalSalari        Decimal             @default(0) @db.Decimal(18, 2)
  incentiusMensual   Decimal             @default(0) @db.Decimal(18, 2)
  incentiuTrimestral Decimal             @default(0) @db.Decimal(18, 2)
  horesExtres        Decimal             @default(0) @db.Decimal(18, 2)
  altres             Decimal             @default(0) @db.Decimal(18, 2)
  baixes             Decimal             @default(0) @db.Decimal(18, 2)
  indemnitzacions    Decimal             @default(0) @db.Decimal(18, 2)
  foraCentre         Decimal             @default(0) @db.Decimal(18, 2)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  carregaId          String?
  carrega            CarregaFitxer?      @relation(fields: [carregaId], references: [id], onDelete: Cascade)
  centre             Centre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  period             Period              @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, centreId, departament])
  @@index([periodId])
  @@index([centreId])
  @@index([carregaId])
  @@index([centreId, periodId])
}

/// Mapeig codi del fitxer payroll → centre Opsia (+ departament de l'arbre si n'hi ha).
model MapeigCodiCostPersonal {
  id                  String               @id @default(cuid())
  /// Codi del fitxer (ex. 02001, 0015, 02001001, 04043005).
  codi                String               @unique
  /// Text descriptiu opcional (ex. ADMINISTRACIO EMPRESA).
  text                String?
  centreId            String
  /// Dimensió 3 de l'arbre (DRO… / DCC…). Null = agregat només al centre.
  departamentId       String?
  /// Compat restaurants / traspassos: SALA/CUINA (es pot inferir del nom del dept).
  departamentSalarial DepartamentSalarial?
  ordre               Int                  @default(0)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  centre              Centre               @relation(fields: [centreId], references: [id], onDelete: Cascade)
  departament         Departament?         @relation(fields: [departamentId], references: [id], onDelete: SetNull)

  @@index([centreId])
  @@index([departamentId])
  @@index([departamentSalarial])
}

/// Fet de cost personal importat (payroll) per període × centre (+ dept Dimensions).
model CostPersonalCentre {
  id                  String                   @id @default(cuid())
  periodId            String
  centreId            String
  /// Nòmina mensual vs millores (mateix layout Excel; millores sense provisió a K).
  origen              OrigenCostPersonalCentre @default(NOMINA)
  /// Dimensió 3 (arbre). Null = agregat només al centre.
  departamentId       String?
  /// Compat restaurants / traspassos: SALA/CUINA.
  departamentSalarial DepartamentSalarial?
  carregaId           String?
  /// Text/codi original de la fila (traçabilitat al detall).
  codiOrigen          String?
  textOrigen          String?
  importBrut          Decimal                  @default(0) @db.Decimal(18, 2)
  /// Columna K: provisió pagues extres. Millores: sempre 0.
  segSocialEmpresa    Decimal                  @default(0) @db.Decimal(18, 2)
  /// Columna L: seguretat social (sempre).
  totalSegSocial      Decimal                  @default(0) @db.Decimal(18, 2)
  /// Columna M: cost personal.
  costPersonal        Decimal                  @default(0) @db.Decimal(18, 2)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  carrega             CarregaFitxer?           @relation(fields: [carregaId], references: [id], onDelete: Cascade)
  centre              Centre                   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  departament         Departament?             @relation(fields: [departamentId], references: [id], onDelete: SetNull)
  period              Period                   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([centreId])
  @@index([departamentId])
  @@index([carregaId])
  @@index([periodId, centreId])
  @@index([periodId, origen])
}

/// Vendes diàries agregades (fitxer V_MM_YYYY[_CC].xls o tickets CCR00008).
/// Imports en Base (sense IVA). Amb forma de pagament: una fila per dia × forma.
model VendaDiariaRestaurant {
  id            String         @id @default(cuid())
  periodId      String
  centreId      String
  dia           Int
  data          DateTime       @db.Date
  unitats       Decimal        @default(0) @db.Decimal(18, 2)
  base          Decimal        @default(0) @db.Decimal(18, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  carregaId     String?
  /// "" = format V clàssic (sense desglossament); "Targeta" | "Efectiu" | …
  formaPagament String         @default("")
  carrega       CarregaFitxer? @relation(fields: [carregaId], references: [id], onDelete: Cascade)
  centre        Centre         @relation(fields: [centreId], references: [id], onDelete: Cascade)
  period        Period         @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, centreId, dia, formaPagament])
  @@index([periodId])
  @@index([centreId])
  @@index([carregaId])
  @@index([centreId, periodId])
}

/// Vendes per article del mes (Detall = productes; Pack = packs/menús). Base sense IVA.
model VendaArticleRestaurant {
  id           String             @id @default(cuid())
  periodId     String
  centreId     String
  origen       OrigenVendaArticle
  article      String
  tipusArticle String?
  unitats      Decimal            @default(0) @db.Decimal(18, 2)
  base         Decimal            @default(0) @db.Decimal(18, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  /// Taxonomia TPV (Article [Grupo] / [Familia] / [Subfamilia])
  grup         String?
  familia      String?
  subfamilia   String?
  /// Derivada: si grup/família/subfamília conté «begud» → BEGUDA; altrament MENJAR (si hi ha taxonomia).
  categoria    CategoriaVenda?
  carregaId    String?
  carrega      CarregaFitxer?     @relation(fields: [carregaId], references: [id], onDelete: Cascade)
  centre       Centre             @relation(fields: [centreId], references: [id], onDelete: Cascade)
  period       Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, centreId, origen, article])
  @@index([periodId])
  @@index([centreId])
  @@index([origen])
  @@index([categoria])
  @@index([carregaId])
  @@index([centreId, periodId, origen])
  @@index([centreId, periodId, categoria])
}

model NormaConsolidacio {
  id                String                  @id @default(cuid())
  codi              String?                 @unique
  nom               String
  descripcio        String?
  grup              GrupConsolidacio
  tipus             TipusNormaConsolidacio
  ordre             Int                     @default(0)
  actiu             Boolean                 @default(true)
  nodeExcloure      Int?
  nodesAjust        Int[]                   @default([])
  grupEmpresaOrigen String?
  nodeOrigen        Int?
  grupEmpresaDesti  String?
  nodeDesti         Int?
  /// Nodes de la cara origen (si buit, s'usa nodeOrigen). Permet suma 7+8, etc.
  nodesOrigen       Int[]                   @default([])
  /// Nodes de la cara destí (si buit, s'usa nodeDesti).
  nodesDesti        Int[]                   @default([])
  /// MIN_COINCIDENT = min(|A|,|B|) de cel·les; IMPORT_FIX_MENSUAL = taula d'imports.
  fontImport        FontImportConsolidacio  @default(MIN_COINCIDENT)
  /// Context consultable (p.ex. "LN00000 · CCC00002 · ENTREGUES Blayeta").
  notaOrigen        String?
  notaDesti         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  imports           NormaConsolidacioImport[]

  @@index([grup])
}

/// Imports mensuals d'una norma (factures IC, imports fixos). Consultables i editables.
model NormaConsolidacioImport {
  id        String            @id @default(cuid())
  normaId   String
  any       Int
  mes       Int
  import_   Decimal           @map("import") @db.Decimal(18, 2)
  nota      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  norma     NormaConsolidacio @relation(fields: [normaId], references: [id], onDelete: Cascade)

  @@unique([normaId, any, mes])
  @@index([normaId, any])
}

